{
  "@id": "dawa-route",
  "match": [
    {
      "host": [
        "{{ .Domain }}"
      ]
    }
  ],
  "handle": [
    {
      "handler": "subroute",
      "routes": [
        {
          "match": [
            {
              "path": [
                "/cable*"
              ]
            }
          ],
          "handle": [
            {
              "handler": "reverse_proxy",
              "upstreams": [
                {
                  "dial": "dawa:3000"
                }
              ],
              "headers": {
                "request": {
                  "set": {
                    "X-Real-IP": [
                      "{http.request.remote.host}"
                    ]
                  }
                }
              },
              "flush_interval": -1
            }
          ]
        },
        {
          "handle": [
            {
              "handler": "reverse_proxy",
              "upstreams": [
                {
                  "dial": "dawa:3000"
                }
              ],
              "headers": {
                "request": {
                  "set": {
                    "X-Real-IP": [
                      "{http.request.remote.host}"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "terminal": true
}
