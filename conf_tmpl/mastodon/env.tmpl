# Some variables in this file will be interpreted differently whether you are
# using docker-compose or not.

LOCAL_DOMAIN={{ .Domain }}
ALTERNATE_DOMAINS={{ .OnionDomain }}
SINGLE_USER_MODE=false
DB_HOST=mastodon-db
DB_PORT=5432
DB_NAME=mastodon
DB_USER=postgres
DB_PASS=
REDIS_HOST=mastodon-redis
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_SERVER="$LOCAL_DOMAIN"
SMTP_DELIVERY_METHOD=smtp
SMTP_AUTH_METHOD=none
SMTP_OPENSSL_VERIFY_MODE=none

# later filled in by install scripts
SECRET_KEY_BASE=
OTP_SECRET=
VAPID_KEYS=
ACTIVE_RECORD=

# OIDC_ISSUER_URL='https://id.example.com/realms/example'
OIDC_SCOPE=openid
OIDC_CLIENT_ID_VALUE={{ .ClientID }}
OIDC_CLIENT_SECRET_VALUE={{ .ClientSecret }}
OIDC_BUTTON_NAME='dcomms SSO'
OIDC_ENABLED=true
OIDC_REDIRECT_URI="$LOCAL_DOMAIN/auth/auth/openid_connect/callback"
# keep login and password
# OMNIAUTH_ONLY=false
# allow unverified emails
# OIDC_SECURITY_ASSUME_EMAIL_IS_VERIFIED=false
